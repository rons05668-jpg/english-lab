# 依赖
node_modules/
.pnp
.pnp.js

# 构建产物
dist/
dist-ssr/
*.local

# 环境变量（只提交 .env.example）
.env
.env.*
!.env.example

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# 测试与工具临时产物
coverage/
.playwright-cli/
test-results/
playwright-report/
.vite/

# Vite 临时文件
*.timestamp-*.mjs

# TypeScript 增量构建缓存
*.tsbuildinfo

# 词典分片的 gzip 副本：由 build:gz 在构建时生成到 dist/dict，不进仓库
public/dict/*.gz
