{
  "name": "english-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "English Lab — Apple 风格智能英语阅读学习平台",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:brief && tsc -b && vite build",
    "build:brief": "node scripts/build-article-brief.mjs",
    "preview": "vite preview --port 4173",
    "validate:content": "node scripts/validate-articles.mjs",
    "build:dict": "node scripts/build-dict-shards.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
